<?xml version='1.0' encoding='utf-8'?>
<policyDefinitions xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions" revision="1.0" schemaVersion="1.0">
  <!-- Custom Claude Desktop Windows policies. Package 1.0.0; reviewed 2026-11-13. Not an Anthropic-issued template. -->
  <policyNamespaces>
    <target prefix="claudedesktop" namespace="Custom.Policies.ClaudeDesktop.v1"/>
  </policyNamespaces>
  <resources minRequiredRevision="1.0"/>
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Claude" displayName="$(string.SUPPORTED_Claude)"/>
      <definition name="SUPPORTED_Effort" displayName="$(string.SUPPORTED_Effort)"/>
      <definition name="SUPPORTED_EDR" displayName="$(string.SUPPORTED_EDR)"/>
    </definitions>
  </supportedOn>
  <categories>
    <category name="ClaudeDesktop" displayName="$(string.CAT_ClaudeDesktop)"/>
    <category name="Identity" displayName="$(string.CAT_Identity)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>
    <category name="Updates" displayName="$(string.CAT_Updates)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>
    <category name="Capabilities" displayName="$(string.CAT_Capabilities)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>
    <category name="Workspace" displayName="$(string.CAT_Workspace)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>
    <category name="EDR" displayName="$(string.CAT_EDR)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>
  </categories>
  <policies>
    <policy name="ForceLoginOrgUUID" displayName="$(string.POL_ForceLoginOrgUUID)" explainText="$(string.HELP_ForceLoginOrgUUID)" key="Software\Policies\Claude" class="Machine" presentation="$(presentation.PRES_ForceLoginOrgUUID)">
      <parentCategory ref="Identity"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <disabledList>
        <item key="Software\Policies\Claude" valueName="forceLoginOrgUUID">
          <value>
            <delete/>
          </value>
        </item>
      </disabledList>
      <elements>
        <text id="ForceLoginOrgUUID_Value" valueName="forceLoginOrgUUID" required="true" maxLength="32767" expandable="false"/>
      </elements>
    </policy>
    <policy name="DisableAutoUpdates" displayName="$(string.POL_DisableAutoUpdates)" explainText="$(string.HELP_DisableAutoUpdates)" key="Software\Policies\Claude" class="Machine" valueName="disableAutoUpdates">
      <parentCategory ref="Updates"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <enabledValue>
        <decimal value="1"/>
      </enabledValue>
      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>
    <policy name="AutoUpdaterEnforcementHours" displayName="$(string.POL_AutoUpdaterEnforcementHours)" explainText="$(string.HELP_AutoUpdaterEnforcementHours)" key="Software\Policies\Claude" class="Machine" presentation="$(presentation.PRES_AutoUpdaterEnforcementHours)">
      <parentCategory ref="Updates"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <disabledList>
        <item key="Software\Policies\Claude" valueName="autoUpdaterEnforcementHours">
          <value>
            <delete/>
          </value>
        </item>
      </disabledList>
      <elements>
        <decimal id="AutoUpdaterEnforcementHours_Value" valueName="autoUpdaterEnforcementHours" required="true" minValue="1" maxValue="72" storeAsText="false"/>
      </elements>
    </policy>
    <policy name="DesktopExtensions" displayName="$(string.POL_DesktopExtensions)" explainText="$(string.HELP_DesktopExtensions)" key="Software\Policies\Claude" class="Machine" valueName="isDesktopExtensionEnabled">
      <parentCategory ref="Capabilities"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <enabledValue>
        <decimal value="1"/>
      </enabledValue>
      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>
    <policy name="ExtensionDirectory" displayName="$(string.POL_ExtensionDirectory)" explainText="$(string.HELP_ExtensionDirectory)" key="Software\Policies\Claude" class="Machine" valueName="isDesktopExtensionDirectoryEnabled">
      <parentCategory ref="Capabilities"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <enabledValue>
        <decimal value="1"/>
      </enabledValue>
      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>
    <policy name="LocalDevMCP" displayName="$(string.POL_LocalDevMCP)" explainText="$(string.HELP_LocalDevMCP)" key="Software\Policies\Claude" class="Machine" valueName="isLocalDevMcpEnabled">
      <parentCategory ref="Capabilities"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <enabledValue>
        <decimal value="1"/>
      </enabledValue>
      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>
    <policy name="ClaudeCode" displayName="$(string.POL_ClaudeCode)" explainText="$(string.HELP_ClaudeCode)" key="Software\Policies\Claude" class="Machine" valueName="isClaudeCodeForDesktopEnabled">
      <parentCategory ref="Capabilities"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <enabledValue>
        <decimal value="1"/>
      </enabledValue>
      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>
    <policy name="Cowork" displayName="$(string.POL_Cowork)" explainText="$(string.HELP_Cowork)" key="Software\Policies\Claude" class="Machine" valueName="secureVmFeaturesEnabled">
      <parentCategory ref="Capabilities"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <enabledValue>
        <decimal value="1"/>
      </enabledValue>
      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>
    <policy name="EffortLevel" displayName="$(string.POL_EffortLevel)" explainText="$(string.HELP_EffortLevel)" key="Software\Policies\Claude" class="Machine" presentation="$(presentation.PRES_EffortLevel)">
      <parentCategory ref="Capabilities"/>
      <supportedOn ref="SUPPORTED_Effort"/>
      <disabledList>
        <item key="Software\Policies\Claude" valueName="effortLevel">
          <value>
            <delete/>
          </value>
        </item>
      </disabledList>
      <elements>
        <enum id="EffortLevel_Value" valueName="effortLevel" required="true">
          <item displayName="$(string.EFFORT_low)">
            <value>
              <string>low</string>
            </value>
          </item>
          <item displayName="$(string.EFFORT_medium)">
            <value>
              <string>medium</string>
            </value>
          </item>
          <item displayName="$(string.EFFORT_high)">
            <value>
              <string>high</string>
            </value>
          </item>
          <item displayName="$(string.EFFORT_xhigh)">
            <value>
              <string>xhigh</string>
            </value>
          </item>
          <item displayName="$(string.EFFORT_max)">
            <value>
              <string>max</string>
            </value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="WorkspaceFolders" displayName="$(string.POL_WorkspaceFolders)" explainText="$(string.HELP_WorkspaceFolders)" key="Software\Policies\Claude" class="Machine" presentation="$(presentation.PRES_WorkspaceFolders)">
      <parentCategory ref="Workspace"/>
      <supportedOn ref="SUPPORTED_Claude"/>
      <disabledList>
        <item key="Software\Policies\Claude" valueName="allowedWorkspaceFolders">
          <value>
            <delete/>
          </value>
        </item>
      </disabledList>
      <elements>
        <text id="WorkspaceFolders_Value" valueName="allowedWorkspaceFolders" required="true" maxLength="32767" expandable="false"/>
      </elements>
    </policy>
    <policy name="EDRPackage" displayName="$(string.POL_EDRPackage)" explainText="$(string.HELP_EDRPackage)" key="Software\Policies\Claude" class="Machine" presentation="$(presentation.PRES_EDRPackage)">
      <parentCategory ref="EDR"/>
      <supportedOn ref="SUPPORTED_EDR"/>
      <disabledList>
        <item key="Software\Policies\Claude" valueName="coworkEDRIntegration">
          <value>
            <delete/>
          </value>
        </item>
      </disabledList>
      <elements>
        <text id="EDRPackage_Value" valueName="coworkEDRIntegration" required="true" maxLength="32767" expandable="false"/>
      </elements>
    </policy>
    <policy name="EDRVendor" displayName="$(string.POL_EDRVendor)" explainText="$(string.HELP_EDRVendor)" key="Software\Policies\Claude" class="Machine" presentation="$(presentation.PRES_EDRVendor)">
      <parentCategory ref="EDR"/>
      <supportedOn ref="SUPPORTED_EDR"/>
      <disabledList>
        <item key="Software\Policies\Claude" valueName="coworkEDRIntegrationVendor">
          <value>
            <delete/>
          </value>
        </item>
      </disabledList>
      <elements>
        <text id="EDRVendor_Value" valueName="coworkEDRIntegrationVendor" required="true" maxLength="1023" expandable="false"/>
      </elements>
    </policy>
  </policies>
</policyDefinitions>

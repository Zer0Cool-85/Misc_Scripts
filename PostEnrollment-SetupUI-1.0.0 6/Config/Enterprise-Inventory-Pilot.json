{
  "SchemaVersion": 1,
  "SetupId": "Company.FirstLogonInventoryPilot",
  "SetupVersion": "1.0.0",
  "Branding": {
    "CompanyName": "YOUR COMPANY",
    "WindowTitle": "Welcome | Device setup",
    "Heading": "Welcome to your new PC",
    "Message": "Preview matched apps, the proposed device name, and OS drive encryption. This profile only collects inventory.",
    "LogoPath": "",
    "BannerPath": "",
    "BannerHeight": 110,
    "BannerStretch": "Uniform",
    "BannerStretchDirection": "DownOnly",
    "LogoMaxWidth": 180,
    "LogoMaxHeight": 48,
    "IconPath": ""
  },
  "Appearance": {
    "Theme": "Light",
    "AccentColor": "#2563EB",
    "SuccessColor": "#16815D",
    "FailureColor": "#C53F4E",
    "WarningColor": "#A86D0B",
    "WindowWidth": 900,
    "WindowHeight": 820,
    "Topmost": true,
    "ReduceMotion": false,
    "ShowElapsedTime": true,
    "ShowStepNumbers": true,
    "FontFamily": "Segoe UI"
  },
  "Text": {
    "RunningHeading": "Getting things ready",
    "RunningMessage": "Your settings and applications are being prepared.",
    "SuccessHeading": "Inventory complete",
    "SuccessMessage": "Review the run log and inventory reports before selecting your production settings.",
    "WarningHeading": "Ready, with a few things to review",
    "WarningMessage": "Required setup is complete. An optional step needs attention.",
    "FailureHeading": "A few things need attention",
    "FailureMessage": "Review the highlighted steps, then retry or contact your IT service desk.",
    "Footer": "Keep your device plugged in and connected.",
    "Support": "Need help? Contact your IT service desk.",
    "RetryButton": "Retry unfinished",
    "CloseButton": "Done",
    "CopyButton": "Copy details",
    "DetailsLabel": "Setup details",
    "SelectionHeading": "Choose optional apps",
    "SelectionMessage": "Select any extras you would like, then start setup. Required setup runs automatically.",
    "StartButton": "Start setup",
    "SelectionFooter": "Optional apps are unchecked by default.",
    "SelectStepLabel": "Include this optional step"
  },
  "Behavior": {
    "RequireSystemForLive": true,
    "ResumeCompletedSteps": false,
    "StopOnRequiredFailure": true,
    "AllowRetry": true,
    "AutoCloseSuccessSeconds": 0,
    "PollIntervalMilliseconds": 400,
    "StateDirectory": "%ProgramData%/Company/PostEnrollmentSetupUI",
    "EnforceFinalRestart": false,
    "RestartCountdownSeconds": 120
  },
  "Steps": [
    {
      "Id": "cleanup",
      "Enabled": true,
      "Title": "Inventory Office",
      "Description": "List desktop and Store Office evidence without uninstalling anything.",
      "Script": "EnterpriseSteps/Step-RemovePreinstalledOfficeOneDrive.ps1",
      "Parameters": {
        "OfficeRemovalMode": "AllOffice",
        "AuditOnly": true,
        "RemoveOneDrive": false
      },
      "TimeoutSeconds": 3600,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [],
      "DemoSeconds": 3,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "oem",
      "Enabled": true,
      "Title": "Inventory OEM apps",
      "Description": "List the manufacturer and matched applications.",
      "Script": "EnterpriseSteps/Step-RemoveOemApps.ps1",
      "Parameters": {
        "Mode": "Audit",
        "CatalogRelativePath": "Catalogs/OemCleanup.json"
      },
      "TimeoutSeconds": 1800,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": false,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "name",
      "Enabled": true,
      "Title": "Preview device name",
      "Description": "Calculate the proposed name without changing Windows.",
      "Script": "EnterpriseSteps/Step-NameDevice.ps1",
      "Parameters": {
        "NameTemplate": "{Prefix}-{Type}{Serial:7}",
        "Prefix": "PC",
        "Site": "",
        "LaptopCode": "L",
        "DesktopCode": "D",
        "PreviewOnly": true
      },
      "TimeoutSeconds": 180,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "bitlocker",
      "Enabled": true,
      "Title": "Review drive encryption",
      "Description": "Check BitLocker on the Windows volume.",
      "Script": "EnterpriseSteps/Step-CheckBitLocker.ps1",
      "Parameters": {
        "Mode": "Audit",
        "AllowEncryptionInProgress": false
      },
      "TimeoutSeconds": 120,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": false,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    }
  ]
}

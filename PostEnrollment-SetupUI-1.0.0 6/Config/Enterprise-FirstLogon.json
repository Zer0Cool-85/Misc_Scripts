{
  "SchemaVersion": 1,
  "SetupId": "Company.FirstLogonProvisioning",
  "SetupVersion": "1.0.0",
  "Branding": {
    "CompanyName": "YOUR COMPANY",
    "WindowTitle": "Welcome | Device setup",
    "Heading": "Welcome to your new PC",
    "Message": "Please wait while we finish setting up your new PC. Windows will restart automatically when setup is complete.",
    "LogoPath": "",
    "BannerPath": "",
    "BannerHeight": 110,
    "BannerStretch": "Uniform",
    "BannerStretchDirection": "DownOnly",
    "LogoMaxWidth": 180,
    "LogoMaxHeight": 48,
    "IconPath": ""
  },
  "Appearance": {
    "Theme": "Light",
    "AccentColor": "#2563EB",
    "SuccessColor": "#16815D",
    "FailureColor": "#C53F4E",
    "WarningColor": "#A86D0B",
    "WindowWidth": 900,
    "WindowHeight": 820,
    "Topmost": true,
    "ReduceMotion": false,
    "ShowElapsedTime": true,
    "ShowStepNumbers": true,
    "FontFamily": "Segoe UI"
  },
  "Text": {
    "RunningHeading": "Getting things ready",
    "RunningMessage": "Your settings and applications are being prepared.",
    "SuccessHeading": "Ready to restart",
    "SuccessMessage": "Your applications and settings are prepared. Windows must restart to finish device setup.",
    "WarningHeading": "Ready, with a few things to review",
    "WarningMessage": "Required setup is complete. An optional step needs attention.",
    "FailureHeading": "A few things need attention",
    "FailureMessage": "Review the highlighted steps, then retry or contact your IT service desk.",
    "Footer": "Keep your device plugged in and connected.",
    "Support": "Need help? Contact your IT service desk.",
    "RetryButton": "Retry unfinished",
    "CloseButton": "Done",
    "CopyButton": "Copy details",
    "DetailsLabel": "Setup details",
    "SelectionHeading": "Choose optional apps",
    "SelectionMessage": "Select any extras you would like, then start setup. Required setup runs automatically.",
    "StartButton": "Start setup",
    "SelectionFooter": "Optional apps are unchecked by default.",
    "SelectStepLabel": "Include this optional step"
  },
  "Behavior": {
    "RequireSystemForLive": true,
    "ResumeCompletedSteps": true,
    "StopOnRequiredFailure": true,
    "AllowRetry": true,
    "AutoCloseSuccessSeconds": 0,
    "PollIntervalMilliseconds": 400,
    "StateDirectory": "%ProgramData%/Company/PostEnrollmentSetupUI",
    "EnforceFinalRestart": true,
    "RestartCountdownSeconds": 120
  },
  "Steps": [
    {
      "Id": "cleanup",
      "Enabled": true,
      "Title": "Remove Office and OneDrive",
      "Description": "Remove existing Office before licensed users install it from Company Portal.",
      "Script": "EnterpriseSteps/Step-RemovePreinstalledOfficeOneDrive.ps1",
      "Parameters": {
        "OfficeRemovalMode": "AllOffice",
        "OdtRelativePath": "Payloads/ODT/setup.exe",
        "GetHelpRelativePath": "Payloads/GetHelp/GetHelpCmd.exe",
        "RemoveOneDrive": true,
        "ForceCloseApps": false
      },
      "TimeoutSeconds": 3600,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [],
      "DemoSeconds": 3,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "oem",
      "Enabled": true,
      "Title": "Remove manufacturer extras",
      "Description": "Remove matched Dell, Lenovo or HP applications.",
      "Script": "EnterpriseSteps/Step-RemoveOemApps.ps1",
      "Parameters": {
        "Mode": "Remove",
        "CatalogRelativePath": "Catalogs/OemCleanup.json"
      },
      "TimeoutSeconds": 1800,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": false,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "name",
      "Enabled": true,
      "Title": "Set the device name",
      "Description": "Apply the configured device naming standard.",
      "Script": "EnterpriseSteps/Step-NameDevice.ps1",
      "Parameters": {
        "NameTemplate": "{Prefix}-{Type}{Serial:7}",
        "Prefix": "PC",
        "Site": "",
        "LaptopCode": "L",
        "DesktopCode": "D",
        "PreviewOnly": false
      },
      "TimeoutSeconds": 180,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "google",
      "Enabled": true,
      "Title": "Prepare Chrome and Google Drive",
      "Description": "Install the Google Workspace apps and check their update status.",
      "Script": "EnterpriseSteps/Step-GoogleWorkspaceApps.ps1",
      "Parameters": {
        "Apps": [
          "Chrome",
          "Drive"
        ],
        "UpdateTimeoutSeconds": 600
      },
      "TimeoutSeconds": 3600,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "portal_check",
      "Enabled": true,
      "Title": "Check Company Portal",
      "Description": "Check availability and record whether installation is needed.",
      "Script": "EnterpriseSteps/Step-DetectCompanyPortal.ps1",
      "Parameters": {
        "RegistryPath": "HKLM:\\SOFTWARE\\Company\\PostEnrollmentSetup"
      },
      "TimeoutSeconds": 120,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [],
      "DemoSeconds": 3,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "portal_install",
      "Enabled": true,
      "Title": "Prepare Company Portal",
      "Description": "Install Company Portal if it is missing.",
      "Script": "EnterpriseSteps/Step-InstallCompanyPortal.ps1",
      "Parameters": {
        "Mode": "WinGetThenOffline",
        "RegistryPath": "HKLM:\\SOFTWARE\\Company\\PostEnrollmentSetup",
        "PackageRelativePath": "Payloads/CompanyPortal/YourPortal.appxbundle",
        "DependencyRelativePaths": [],
        "LicenseRelativePath": "Payloads/CompanyPortal/YourLicense.xml",
        "AllowUnlicensedPackage": false,
        "WinGetTimeoutSeconds": 600,
        "WinGetVerifySeconds": 30
      },
      "TimeoutSeconds": 2400,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [
        "portal_check"
      ],
      "DemoSeconds": 3,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "notepad",
      "Enabled": true,
      "Title": "Prepare Windows Notepad",
      "Description": "Install Windows Notepad if it is missing.",
      "Script": "EnterpriseSteps/Step-InstallNotepad.ps1",
      "Parameters": {
        "Mode": "WinGetThenOffline",
        "PackageRelativePath": "Payloads/Notepad/YourNotepad.msixbundle",
        "DependencyRelativePaths": [],
        "LicenseRelativePath": "Payloads/Notepad/YourLicense.xml",
        "AllowUnlicensedPackage": false,
        "WinGetTimeoutSeconds": 600,
        "WinGetVerifySeconds": 30
      },
      "TimeoutSeconds": 2400,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [],
      "DemoSeconds": 3,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "bitlocker",
      "Enabled": true,
      "Title": "Review drive encryption",
      "Description": "Check BitLocker on the Windows volume.",
      "Script": "EnterpriseSteps/Step-CheckBitLocker.ps1",
      "Parameters": {
        "Mode": "Audit",
        "AllowEncryptionInProgress": false
      },
      "TimeoutSeconds": 120,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": false,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    },
    {
      "Id": "updates",
      "Enabled": true,
      "Title": "Check for other application updates",
      "Description": "Apply available updates; remaining items can be handled later.",
      "Script": "EnterpriseSteps/Step-UpdateOtherApps.ps1",
      "Parameters": {
        "RunMachineUpdates": true,
        "RunUserUpdates": true,
        "MachineSource": "winget",
        "ExcludeMachineIds": [
          "Google.Chrome",
          "Google.GoogleDrive"
        ],
        "MachineTimeoutSeconds": 900,
        "UserTimeoutSeconds": 300
      },
      "TimeoutSeconds": 1800,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": false,
      "DependsOn": [],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false,
      "NonBlockingSkipExitCodes": [
        20001
      ]
    },
    {
      "Id": "restart",
      "Enabled": true,
      "Title": "Prepare the required restart",
      "Description": "Windows will restart after setup finishes.",
      "Script": "EnterpriseSteps/Step-RequireRestart.ps1",
      "Parameters": {},
      "TimeoutSeconds": 60,
      "SuccessExitCodes": [
        0,
        3010
      ],
      "RebootExitCodes": [
        3010
      ],
      "Required": true,
      "DependsOn": [
        "cleanup",
        "name",
        "google",
        "portal_install",
        "notepad"
      ],
      "DemoSeconds": 2,
      "DemoFailFirstAttempt": false,
      "UserSelectable": false
    }
  ]
}

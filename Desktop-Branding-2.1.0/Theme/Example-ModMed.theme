; Example only. Select explicitly with -ThemeFile "Example-ModMed.theme".
; In branding mode the Wallpaper line is replaced by the packaged image.
; For a bundled image in preserve mode, use:
; Wallpaper=%BRANDINGTHEMEDIR%\Assets\YourWallpaper.jpg
[Theme]
DisplayName=ModMed Custom

[Control Panel\Desktop]
Wallpaper=%SystemRoot%\Web\Wallpaper\Windows\img0.jpg
TileWallpaper=0
WallpaperStyle=10

[VisualStyles]
Path=%SystemRoot%\Resources\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
ColorizationColor=0xC43F177E
AutoColorization=0
SystemMode=Dark
AppMode=Light

[MasterThemeSelector]
MTSM=DABJDKT
